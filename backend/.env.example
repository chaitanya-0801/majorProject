# AttendEase Backend Environment Configuration

# Server Port
PORT=5050

# MongoDB Connection String (Atlas or Local)
DB_URI="mongodb+srv://<username>:<password>@cluster.mongodb.net/AttendEase?retryWrites=true&w=majority"

# JWT Secret for Session & Expiring QR Tokens
JWT_SECRET="replace_with_a_secure_jwt_secret_key"

# Client Frontend URL for CORS & QR Links
CLIENT_URL="http://localhost:3000"

# Google Gemini API Key for AI Personalized Curriculum Planning
# If left empty, system automatically operates using the deterministic syllabus engine
GEMINI_API_KEY="AQ.Ab8RN6IdvTiL2n44nwFhDQU6Xg0qSyqAO1SOYwGOWi7hPyhlFQ"

# Email Configuration (Nodemailer for OTP Verification)
EMAIL="institution.notifications@gmail.com"
PASSWORD="google_app_password"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_TLS=true

# Cloudinary Image Storage (Webcam Photo Proofs)
# If left unconfigured, system safely saves and serves from local public/uploads directory
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Initial Administrator Account Credentials for Seeding
ADMIN_EMAIL="admin@institution.edu"
ADMIN_PASSWORD="AdminSecurePass@2026!"
ADMIN_NAME="System Administrator"
ADMIN_PHONE="9876543210"
ADMIN_ID="ADM-001"

